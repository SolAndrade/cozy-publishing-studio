COZY_ENV=development
COZY_DATA_DIR=.cozy-data
COZY_PROJECTS_DIR=.cozy-data/projects
COZY_JOBS_DIR=.cozy-data/jobs
COZY_ARTIFACTS_DIR=.cozy-data/artifacts
COZY_JOB_STALE_SECONDS=900
COZY_WORKER_POLL_SECONDS=1
COZY_PUBLIC_APP_ORIGIN=https://solandrade.github.io/cozy-publishing-studio

# Production API authentication. Generate this directly in the private host.
COZY_API_TOKEN=

# Provider selection. Development defaults may use mock/local adapters.\n# Real provider execution stays disabled until deliberately enabled.\nCOZY_ENABLE_PAID_PROVIDERS=false
COZY_IMAGE_PROVIDER=mock
COZY_VISION_PROVIDER=mock
# local is development-only. Production must use a durable shared adapter.
COZY_ARTIFACT_STORE=local
# Production durable artifacts (S3-compatible, private bucket)
COZY_S3_BUCKET=
COZY_S3_ENDPOINT=
COZY_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Keep real provider credentials ONLY in the private backend host.
# Never place secrets in GitHub Pages or commit them to this public repository.
OPENAI_API_KEY=
COZY_STORAGE_API_KEY=
